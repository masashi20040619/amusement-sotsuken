      "source": [
        "# NFKC正規化によるIP・SNSの二重カウントを修正\n",
        "keyword_df[\"IP\"] = (keyword_df[\"IP\"] // 2).astype(int)\n",
        "keyword_df[\"SNS\"] = (keyword_df[\"SNS\"] // 2).astype(int)\n",
        "\n",
        "# 年度別に再集計\n",
        "keyword_cols = [\n",
        "    \"クレーン\", \"プライズ\", \"景品\", \"キャラクター\",\n",
        "    \"IP\", \"SNS\", \"インバウンド\",\n",
        "    \"キャッシュレス\", \"省人化\", \"ショッピングセンター\"\n",
        "]\n",
        "\n",
        "yearly_keywords = (\n",
        "    keyword_df\n",
        "    .groupby(\"年度\")[[\"文字数\"] + keyword_cols]\n",
        "    .sum()\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "# 1万文字当たりに再計算\n",
        "for kw in keyword_cols:\n",
        "    yearly_keywords[f\"{kw}_1万文字当たり\"] = (\n",
        "        yearly_keywords[kw] / yearly_keywords[\"文字数\"] * 10000\n",
        "    )\n",
        "\n",
        "yearly_keywords"
      ]
    },
