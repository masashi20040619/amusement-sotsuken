        "import pandas as pd\n",
        "import requests\n",
        "from pypdf import PdfReader\n",
        "from io import BytesIO\n",
        "import time\n",
        "import unicodedata\n",
        "\n",
        "# 表記揺れをまとめる\n",
        "keyword_groups = {\n",
        "    \"クレーン\": [\"クレーン\"],\n",
        "    \"プライズ\": [\"プライズ\"],\n",
        "    \"景品\": [\"景品\"],\n",
        "    \"キャラクター\": [\"キャラクター\"],\n",
        "    \"IP\": [\"IP\", \"ＩＰ\"],\n",
        "    \"SNS\": [\"SNS\", \"ＳＮＳ\"],\n",
        "    \"インバウンド\": [\"インバウンド\"],\n",
        "    \"キャッシュレス\": [\"キャッシュレス\"],\n",
        "    \"省人化\": [\"省人化\"],\n",
        "    \"ショッピングセンター\": [\n",
        "        \"ショッピングセンター\",\n",
        "        \"ショッピング・センター\"\n",
        "    ]\n",
        "}\n",
        "\n",
        "results = []\n",
        "\n",
        "pdf_urls = jaia_urls[\n",
        "    jaia_urls[\"PDF直接リンク\"] == True\n",
        "].copy()\n",
        "\n",
        "for i, (_, row) in enumerate(pdf_urls.iterrows(), 1):\n",
        "\n",
        "    try:\n",
        "        response = requests.get(row[\"URL\"], timeout=30)\n",
        "        response.raise_for_status()\n",
        "\n",
        "        reader = PdfReader(BytesIO(response.content))\n",
        "\n",
        "        text = \"\"\n",
        "\n",
        "        for page in reader.pages:\n",
        "            page_text = page.extract_text()\n",
        "\n",
        "            if page_text:\n",
        "                text += page_text + \"\\n\"\n",
        "\n",
        "        # 全角英数字などを正規化\n",
        "        text = unicodedata.normalize(\"NFKC\", text)\n",
        "\n",
        "        result = {\n",
        "            \"年度\": row[\"年度\"],\n",
        "            \"URL\": row[\"URL\"],\n",
        "            \"文字数\": len(text)\n",
        "        }\n",
        "\n",
        "        for name, variants in keyword_groups.items():\n",
        "            result[name] = sum(\n",
        "                text.count(\n",
        "                    unicodedata.normalize(\"NFKC\", word)\n",
        "                )\n",
        "                for word in variants\n",
        "            )\n",
        "\n",
        "        results.append(result)\n",
        "\n",
        "        print(f\"{i}/{len(pdf_urls)} 完了\")\n",
        "\n",
        "        time.sleep(0.3)\n",
        "\n",
        "    except Exception as e:\n",
        "\n",
        "        print(\"エラー:\", row[\"URL\"], e)\n",
        "\n",
        "keyword_df = pd.DataFrame(results)\n",
        "\n",
        "print(\"分析成功:\", len(keyword_df), \"資料\")\n",
        "keyword_df.head()"
      ]
    },
