        "\n",
        "experience_contexts = []\n",
        "\n",
        "for _, row in recent_text_df.iterrows():\n",
        "\n",
        "    text = row[\"本文\"]\n",
        "\n",
        "    for keyword in experience_keywords:\n",
        "\n",
        "        for match in re.finditer(re.escape(keyword), text):\n",
        "\n",
        "            start = max(0, match.start() - 120)\n",
        "            end = min(len(text), match.end() + 120)\n",
        "\n",
        "            experience_contexts.append({\n",
        "                \"年度\": row[\"年度\"],\n",
        "                \"キーワード\": keyword,\n",
        "                \"文脈\": text[start:end]\n",
        "            })\n",
        "\n",
        "experience_context_df = pd.DataFrame(experience_contexts)\n",
        "\n",
        "print(\"抽出件数:\", len(experience_context_df))\n",
