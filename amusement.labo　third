        "]\n",
        "\n",
        "social_contexts = []\n",
        "\n",
        "for _, row in recent_text_df.iterrows():\n",
        "\n",
        "    text = row[\"本文\"]\n",
        "\n",
        "    for keyword in social_keywords:\n",
        "\n",
        "        for match in re.finditer(keyword, text):\n",
        "\n",
        "            start = max(0, match.start() - 100)\n",
        "            end = min(len(text), match.end() + 100)\n",
        "\n",
        "            social_contexts.append({\n",
        "                \"年度\": row[\"年度\"],\n",
        "                \"キーワード\": keyword,\n",
        "                \"文脈\": text[start:end]\n",
        "            })\n",
        "\n",
        "social_context_df = pd.DataFrame(social_contexts)\n",
