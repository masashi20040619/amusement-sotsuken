        "# 運営効率・省力化に直接関係する文脈だけ抽出\n",
        "efficiency_pattern = (\n",
        "    \"省力|省人|効率|集金|売上管理|在庫|発注|\"\n",
        "    \"人手不足|人件費|コスト|収益|利益|運営|オペレーション\"\n",
        ")\n",
        "\n",
        "efficiency_relevant_df = efficiency_context_df[\n",
        "    efficiency_context_df[\"文脈\"].str.contains(\n",
        "        efficiency_pattern,\n",
