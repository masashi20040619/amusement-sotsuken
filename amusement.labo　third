        "import requests\n",
        "from pypdf import PdfReader\n",
        "from io import BytesIO\n",
        "import unicodedata\n",
        "import re\n",
        "import pandas as pd\n",
        "import time\n",
        "\n",
        "text_rows = []\n",
        "\n",
        "for i, (_, row) in enumerate(recent_pdfs.iterrows(), 1):\n",
        "\n",
        "    try:\n",
        "        response = requests.get(row[\"URL\"], timeout=30)\n",
        "        response.raise_for_status()\n",
        "\n",
        "        reader = PdfReader(BytesIO(response.content))\n",
        "\n",
        "        text = \"\"\n",
        "\n",
        "        for page in reader.pages:\n",
        "            page_text = page.extract_text()\n",
        "            if page_text:\n",
        "                text += page_text + \" \"\n",
        "\n",
        "        # 表記・空白を整理\n",
        "        text = unicodedata.normalize(\"NFKC\", text)\n",
        "        text = re.sub(r\"\\s+\", \" \", text)\n",
        "\n",
        "        text_rows.append({\n",
        "            \"年度\": row[\"年度\"],\n",
        "            \"URL\": row[\"URL\"],\n",
        "            \"本文\": text\n",
        "        })\n",
        "\n",
        "        print(f\"{i}/{len(recent_pdfs)} 完了\")\n",
        "\n",
        "        time.sleep(0.2)\n",
        "\n",
        "    except Exception as e:\n",
        "        print(\"エラー:\", row[\"URL\"], e)\n",
        "\n",
        "recent_text_df = pd.DataFrame(text_rows)\n",
        "\n",
        "print(\"保存できたPDF:\", len(recent_text_df))"
      ]
