    {
      "cell_type": "code",
      "source": [
        "r_ip = merged_df[\"商品化権市場_億円\"].corr(\n",
        "    merged_df[\"プライズゲーム売上高_億円\"]\n",
        ")\n",
        "\n",
        "print(\"相関係数:\", round(r_ip, 3))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "dvuL5LfjJbPt",
        "outputId": "9426581c-d377-4270-988a-58b5ee6c3a67"
      },
      "execution_count": 52,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "相関係数: 0.84\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from scipy.stats import linregress\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "x_ip = merged_df[\"商品化権市場_億円\"]\n",
        "y_ip = merged_df[\"プライズゲーム売上高_億円\"]\n",
        "\n",
        "result_ip = linregress(x_ip, y_ip)\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "\n",
        "plt.scatter(x_ip, y_ip)\n",
        "\n",
        "plt.plot(\n",
        "    x_ip,\n",
        "    result_ip.intercept + result_ip.slope * x_ip\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Character Merchandising Market (100 million yen)\")\n",
        "plt.ylabel(\"Prize Game Sales (100 million yen)\")\n",
        "plt.title(\"Character Merchandising Market vs Prize Game Sales\")\n",
        "\n",
        "plt.grid(alpha=0.3)\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 564
        },
        "id": "eG7WoNVWJhpi",
        "outputId": "58172fb9-228a-4161-bff5-0b85d4c5f5f1"
      },
      "execution_count": 53,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 800x600 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"傾き:\", round(result_ip.slope, 3))\n",
        "print(\"相関係数 r:\", round(result_ip.rvalue, 3))\n",
        "print(\"決定係数 R²:\", round(result_ip.rvalue**2, 3))\n",
        "print(\"p値:\", round(result_ip.pvalue, 4))"
      ],
