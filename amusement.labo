    {
      "cell_type": "markdown",
      "source": [
        "2014→2019で、\n",
        "店舗数は約22%減ったのに、市場規模は約28%拡大し、1店舗当たり売上は約64%増えた"
      ],
      "metadata": {
        "id": "a1sZHNv5_BUj"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "plt.plot(\n",
        "    pre_covid[\"年度\"],\n",
        "    pre_covid[\"店舗数指数\"],\n",
        "    marker=\"o\",\n",
        "    label=\"Number of stores\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    pre_covid[\"年度\"],\n",
        "    pre_covid[\"市場規模指数\"],\n",
        "    marker=\"o\",\n",
        "    label=\"Market size\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    pre_covid[\"年度\"],\n",
        "    pre_covid[\"1店舗売上指数\"],\n",
        "    marker=\"o\",\n",
        "    label=\"Sales per store\"\n",
        ")\n",
        "\n",
        "plt.axhline(100, linestyle=\"--\", alpha=0.5)\n",
        "\n",
        "plt.xlabel(\"Year\")\n",
        "plt.ylabel(\"Index (2014 = 100)\")\n",
        "plt.title(\"Changes in Japanese Amusement Arcade Market\")\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "\n",
        "plt.show()"
      ],
