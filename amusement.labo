    {
      "cell_type": "markdown",
      "source": [
        "市場全体は約1.46倍なのに、プライズは約2.33倍"
      ],
      "metadata": {
        "id": "NN9CTIaZCR5O"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 2014年度を100として指数化\n",
        "base = df[df[\"年度\"] == 2014].iloc[0]\n",
        "\n",
        "df[\"市場全体_指数\"] = (\n",
        "    df[\"ゲームセンター全体売上高_億円\"]\n",
        "    / base[\"ゲームセンター全体売上高_億円\"]\n",
        "    * 100\n",
        ")\n",
        "\n",
        "df[\"プライズ_指数\"] = (\n",
        "    df[\"プライズゲーム売上高_億円\"]\n",
        "    / base[\"プライズゲーム売上高_億円\"]\n",
        "    * 100\n",
        ")\n",
        "\n",
        "# グラフ\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "plt.plot(\n",
        "    df[\"年度\"],\n",
        "    df[\"市場全体_指数\"],\n",
        "    marker=\"o\",\n",
        "    label=\"Total amusement market\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    df[\"年度\"],\n",
        "    df[\"プライズ_指数\"],\n",
        "    marker=\"o\",\n",
        "    label=\"Prize game market\"\n",
        ")\n",
        "\n",
        "plt.axhline(100, linestyle=\"--\", alpha=0.5)\n",
        "\n",
        "plt.xlabel(\"Fiscal Year\")\n",
        "plt.ylabel(\"Index (2014 = 100)\")\n",
        "plt.title(\"Growth of Amusement and Prize Game Markets\")\n",
        "\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 297
